{
  "name": "vela",
  "private": true,
  "version": "1.0.0",
  "description": "Self-hostable video infrastructure: upload, encode, stream, live, DRM, analytics.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r --filter ./packages/player build && pnpm -r --filter ./apps/* build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @vela/db generate",
    "db:migrate": "pnpm --filter @vela/db migrate",
    "test": "pnpm -r test",
    "smoke-test": "node scripts/smoke-test.mjs",
    "setup:bucket": "node --env-file=.env scripts/setup-bucket.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "jose": "^5.9.6",
    "@aws-sdk/client-s3": "^3.716.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
