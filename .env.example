# ======================================================================
#  Vela configuration. Copy to .env and fill in. Values marked REQUIRED
#  must be set; everything else has a sensible default.
# ======================================================================

# ---------- Secrets (REQUIRED) ----------
# 32+ random characters. Encrypts DRM keys and provider secrets, signs internal tokens.
# Generate: openssl rand -hex 32      (never change it after you have DRM videos)
MASTER_KEY=
# Shared secret between MediaMTX and the API. Generate: openssl rand -hex 24
INTERNAL_SECRET=
POSTGRES_PASSWORD=vela

# ---------- Database & queue ----------
# docker-compose sets these for you; set them when running services elsewhere.
# DATABASE_URL=postgres://vela:vela@localhost:5432/vela
# REDIS_URL=redis://localhost:6379
DATABASE_POOL_SIZE=10

# ---------- Object storage (any S3-compatible API) (REQUIRED) ----------
#
# Local Garage (default docker-compose, https://garagehq.deuxfleurs.fr). garage-init imports this
# key into Garage on start, so it must use Garage's key format:
#   S3_ACCESS_KEY_ID      = GK + 24 hex chars   ->  echo GK$(openssl rand -hex 12)
#   S3_SECRET_ACCESS_KEY  = 64 hex chars        ->  openssl rand -hex 32
S3_ENDPOINT=http://garage:3900
# Presigned URLs handed to browsers (uploads, MP4 downloads) use this host instead.
S3_PUBLIC_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=vela
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Garage node secrets (only used by the garage / garage-init services).
# GARAGE_RPC_SECRET: openssl rand -hex 32     GARAGE_ADMIN_TOKEN: openssl rand -base64 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# After the first start, allow browser uploads (sets CORS on the bucket):
#   S3_ENDPOINT=http://localhost:3900 node --env-file=.env scripts/setup-bucket.mjs --origins http://localhost:4000
#
# Production: Cloudflare R2 (zero egress fees). Start without Garage:
#   docker compose up -d --build --scale garage=0 --scale garage-init=0
# Create a bucket + an R2 API token (Object Read & Write):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=vela
# S3_ACCESS_KEY_ID=<R2 access key id>
# S3_SECRET_ACCESS_KEY=<R2 secret access key>
# S3_FORCE_PATH_STYLE=true
# Then allow browser uploads: pnpm setup:bucket   (sets CORS on the bucket)
#
# AWS S3: S3_ENDPOINT empty, S3_REGION=us-east-1 (yours), S3_FORCE_PATH_STYLE=false
# Backblaze B2: S3_ENDPOINT=https://s3.<region>.backblazeb2.com
# Wasabi: S3_ENDPOINT=https://s3.<region>.wasabisys.com

# ---------- Public URLs ----------
# Where browsers reach the API/dashboard and the playback service. Put your CDN
# (e.g. Cloudflare proxied domain) in front of STREAM_PUBLIC_URL in production.
API_PUBLIC_URL=http://localhost:4000
STREAM_PUBLIC_URL=http://localhost:4100
DASHBOARD_URL=http://localhost:4000
# Extra origins allowed to call /v1 from browsers (comma separated).
CORS_ORIGINS=http://localhost:5173
# Set to true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_DOMAIN=.example.com
# Allow anyone to create an account (the first account can always be created).
SIGNUPS_ENABLED=true
RATE_LIMIT_PER_MINUTE=1200

# ---------- Playback delivery ----------
# proxy: segments stream through the stream service (cache them at your CDN)
# redirect: 302 to short-lived presigned storage URLs (offloads bandwidth to R2/S3 directly)
STREAM_SEGMENT_MODE=proxy
STREAM_FFMPEG_CONCURRENCY=4

# ---------- Live streaming ----------
# What encoders (OBS etc.) connect to. MediaMTX listens on 1935 (RTMP) and 8890/udp (SRT).
LIVE_RTMP_PUBLIC_URL=rtmp://localhost:1935/live
# LIVE_RTMPS_PUBLIC_URL=rtmps://live.example.com:443/live
LIVE_SRT_PUBLIC_URL=srt://localhost:8890

# ---------- Encoding ----------
# Parallel transcodes per worker process. Scale out with more worker containers.
TRANSCODE_CONCURRENCY=1
# x264 speed/quality: ultrafast | superfast | veryfast | faster | fast | medium
X264_PRESET=veryfast
# nvenc = NVIDIA GPU encoding (needs an NVIDIA runtime and an ffmpeg build with nvenc)
HW_ACCEL=none
# Restrict a worker to some queues (e.g. video for encode boxes, ai,webhooks,live,maintenance for others)
# WORKER_QUEUES=video
# Max input file size (bytes)
MAX_INPUT_BYTES=53687091200
# Allow importing from private/internal URLs (off by default to prevent SSRF)
ALLOW_PRIVATE_INPUT_URLS=false

# ---------- AI captions, translation, summaries (optional) ----------
# none | openai | cloudflare
TRANSCRIPTION_PROVIDER=none
# OpenAI or any OpenAI-compatible API (Groq, Together, a local faster-whisper server...)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1
# LLM_MODEL=gpt-4o-mini
# Cloudflare Workers AI
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
# CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct

# ---------- Usage cost estimate shown in the dashboard (optional, USD) ----------
USAGE_RATE_ENCODING_PER_MIN=0
USAGE_RATE_STORAGE_PER_MIN_MONTH=0
USAGE_RATE_DELIVERY_PER_MIN=0

LOG_LEVEL=info
